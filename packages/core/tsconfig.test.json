// Type-checks the tests and the layout taste-test tools, which Node runs with
// its types stripped but never checked. Part of `build`, so `pnpm test` and CI
// catch type errors there too.
{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": { "noEmit": true, "declaration": false, "sourceMap": false, "types": ["node"] },
  "include": ["src", "test", "../../tools/layout-taste-test"]
}
