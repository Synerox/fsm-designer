{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FSM Designer",
  "version": "0.1.0",
  "identifier": "com.fsmdesigner.app",
  "build": {
    "frontendDist": "../../editor/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @fsm/editor dev",
    "beforeBuildCommand": "pnpm --filter @fsm/editor build"
  },
  "app": {
    "windows": [
      {
        "title": "FSM Designer",
        "width": 1280,
        "height": 820,
        "minWidth": 800,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
